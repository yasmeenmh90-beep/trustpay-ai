# Optional local trial license; required under AG Studio terms for hosted evaluation.
# Never put PayPal secrets, the backend access key or Channel3 credentials here.
VITE_AG_STUDIO_LICENSE_KEY=

# When the SPA is hosted separately from FastAPI (e.g. Vercel frontend + Render/Fly API),
# set this to the public API origin with no trailing slash. Leave empty for local Vite
# proxy (npm run dev) or same-origin Docker/Render single-service deploys.
# Example: VITE_API_BASE_URL=https://trustpay-api.example.com
VITE_API_BASE_URL=
