# --- PayPal (required) ---
# developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook id from the same app's Webhooks section (required for /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Public URL of this API; PayPal redirects the buyer to $PUBLIC_BASE_URL/api/paypal/return
PUBLIC_BASE_URL=http://localhost:8000
CURRENCY=USD

# --- LLM (required): anthropic | openai ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# LLM_MODEL=                                   # defaults: claude-sonnet-5-5 / gpt-4o-mini

# --- Optional / production ---
TRUSTPAY_DB=trustpay.db
# development (default) | production — production requires TRUSTPAY_API_KEY
TRUSTPAY_ENV=development
# Required in production; every protected /api call needs header X-API-Key
TRUSTPAY_API_KEY=
# Comma-separated browser origins for CORS when the UI is on a different host (Vercel Path B).
# Same-origin Fly/Docker: set FRONTEND_URL equal to PUBLIC_BASE_URL and leave this empty.
# Example for Vercel: https://your-app.vercel.app
ALLOWED_ORIGINS=
# Optional Host allow-list for TrustedHostMiddleware (comma-separated). Leave empty locally.
# Example: trustpay-api.example.com,localhost
ALLOWED_HOSTS=
# Where PayPal return/cancel send the buyer's browser (empty = return JSON)
FRONTEND_URL=
# Max /api/analyze* calls per client IP per minute (0 = off)
RATE_LIMIT_PER_MIN=20
# Set true behind Render/Fly/nginx so rate limits use X-Forwarded-For
TRUST_PROXY=false
# Override OpenAPI UI: empty = off in production / on in development
# TRUSTPAY_ENABLE_DOCS=false

# Sponsor product comparison (server-side only)
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# Default PayPal checkout language: en-US, ar-AE, fr-FR
PAYPAL_LOCALE=en-US
